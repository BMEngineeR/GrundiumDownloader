# Copy to .env and fill in, or export these in your shell / systemd unit.
GRUNDIUM_USERNAME=you@example.com
GRUNDIUM_PASSWORD=change-me
# Optional. Substring of the device name, serial or UUID to pick when the account has several scanners.
GRUNDIUM_DEVICE=
# Optional. Where verified files land. Default: ./downloads
GRUNDIUM_DEST=./downloads
# Optional. Manifest and captures. Default: ./data
GRUNDIUM_STATE_DIR=./data
# Optional. Set to false to watch the browser while debugging.
GRUNDIUM_HEADLESS=true
